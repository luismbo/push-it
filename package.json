{
  "name": "push-it",
  "version": "1.2.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build:extension": "bun build src/lib/pairing.ts --format=esm --target=browser --outfile=extension/pairing.js --banner='// Generated from src/lib/pairing.ts by `bun run build:extension`. Do not edit.'",
    "build": "bun run build:extension && bun run scripts/sign-firefox.ts && vite build",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "gen:vapid": "bun run scripts/gen-vapid.ts",
    "bump:patch": "bun run scripts/bump-version.ts patch",
    "bump:minor": "bun run scripts/bump-version.ts minor",
    "bump:major": "bun run scripts/bump-version.ts major",
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@noble/curves": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@solidjs/web": "^2.0.3",
    "qrcode": "^1.5.4",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "@solidjs/vite-plugin": "^3.0.1",
    "@types/qrcode": "^1.5.5",
    "fflate": "^0.8.3",
    "typescript": "^5.8.0",
    "vite": "^8.3.8",
    "wrangler": "^4.0.0"
  }
}
